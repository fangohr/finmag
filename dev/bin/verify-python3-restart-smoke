#!/usr/bin/env bash
#
# Build the Python 3 DOLFIN 2017 transition image and verify that Finmag can
# save and reload restart data for the barmini example against a writable copy
# of the current checkout.
#
# Usage:
#   dev/bin/verify-python3-restart-smoke
#
# Notes:
# - the repository is mounted read-only into the container;
# - the checkout is copied to /tmp/finmag inside the container because
#   importing and running Finmag may trigger native rebuilds that need write
#   access;
# - OMPI_MCA_plm=isolated is required so `import dolfin` works reliably
#   inside Docker;
# - this keeps barmini as the practical M1 witness while also exercising the
#   restart/save-load path explicitly. [Codex GPT-5.4]

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
image_name="finmag-py3-dolfin2017"

if [[ "${FINMAG_PY3_SKIP_BUILD:-0}" != "1" ]]; then
    docker build \
        -f "${repo_root}/install/docker/python3-dolfin2017-snapshot/Dockerfile" \
        -t "${image_name}" \
        "${repo_root}"
fi

docker run --rm \
    -e OMPI_MCA_plm=isolated \
    -v "${repo_root}:/repo:ro" \
    "${image_name}" \
    bash -lc '
        rm -rf /tmp/finmag &&
        cp -a /repo /tmp/finmag &&
        cd /tmp/finmag &&
        PYTHONPATH=/tmp/finmag/src python3 - <<"PY"
import os
import numpy as np
import finmag

sim = finmag.example.barmini(name="barmini_restart_py3_smoke")
sim.run_until(1e-11)
sim.save_restart_data()

t_saved = sim.t
m_saved = sim.m.copy()
canonical_restart = sim.name + "-restart.npz"
assert os.path.exists(canonical_restart)

sim.run_until(2e-11)
sim.restart()
assert sim.t == t_saved
assert np.allclose(sim.m, m_saved)  # Restart should recover the saved state, not just the saved time. [Codex GPT-5.4]

sim2 = finmag.example.barmini(name="barmini_restart_py3_smoke_copy")
sim2.restart(canonical_restart)
assert sim2.t == t_saved
assert np.allclose(sim2.m, m_saved)

print("saved_time", t_saved)
print("restarted_time", sim.t)
print("copied_time", sim2.t)
print("restart_file", canonical_restart)
PY
    '
