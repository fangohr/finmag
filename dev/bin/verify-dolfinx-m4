#!/usr/bin/env bash
#
# Run the first isolated M4 dependency probe for the DOLFINx track.
#
# This does not port Finmag yet; it only verifies that pixi can provide a
# separate DOLFINx environment and execute a tiny mesh/function workflow without
# disturbing the FEniCS-2019 M2/M3 environment. [Codex gpt-5.5 high]

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

# Keep pixi global/cache state out of the checkout and writable on restricted
# runners. The actual environment prefix remains managed by pixi. [Codex
# gpt-5.5 high]
export PIXI_HOME="${PIXI_HOME:-/tmp/pixi-cache}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-/tmp/pixi-cache}"
export PIXI_CACHE_DIR="${PIXI_CACHE_DIR:-/tmp/pixi-cache}"

cd "${repo_root}"

echo "==> pixi run -e dolfinx dolfinx-import"
pixi run -e dolfinx dolfinx-import

echo "==> pixi run -e dolfinx dolfinx-smoke"
pixi run -e dolfinx dolfinx-smoke
