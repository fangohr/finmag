#!/usr/bin/env bash
#
# Build the Python 3 DOLFIN 2017 transition image and verify that Finmag can
# construct the pre-relaxed normal-modes nanodisk example and compute a small
# normal-mode spectrum inside it against a writable copy of the current
# checkout.
#
# Usage:
#   dev/bin/verify-python3-normal-modes-smoke
#
# Notes:
# - the repository is mounted read-only into the container;
# - the checkout is copied to /tmp/finmag inside the container because
#   importing and running Finmag may trigger native rebuilds that need write
#   access;
# - OMPI_MCA_plm=isolated is required so `import dolfin` works reliably
#   inside Docker;
# - the smoke path reuses the checked-in nanodisk mesh and relaxed restart
#   state so this verifies the Python 3 normal-modes runtime without adding a
#   fresh meshing or relaxation cost. [Codex GPT-5.4]

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
image_name="finmag-py3-dolfin2017"

if [[ "${FINMAG_PY3_SKIP_BUILD:-0}" != "1" ]]; then
    docker build \
        -f "${repo_root}/install/docker/python3-dolfin2017-snapshot/Dockerfile" \
        -t "${image_name}" \
        "${repo_root}"
fi

docker run --rm \
    -e OMPI_MCA_plm=isolated \
    -v "${repo_root}:/repo:ro" \
    "${image_name}" \
    bash -lc '
        rm -rf /tmp/finmag &&
        mkdir -p /tmp/finmag &&
        cd /repo &&
        tar --exclude=.pixi -cf - . | tar -xf - -C /tmp/finmag &&  # Skip repo-local pixi state so the smoke scripts stay portable. [Codex GPT-5.4]
        cd /tmp/finmag &&
        PYTHONPATH=/tmp/finmag/src python3 - <<"PY"
import finmag

sim = finmag.example.normal_modes.disk(relaxed=True, name="normal_modes_py3_smoke")
print("constructed", sim.__class__.__name__)

omega, eigenvecs, rel_errors = sim.compute_normal_modes(n_values=2)
assert len(omega) == 2
assert len(eigenvecs) == 2
assert len(rel_errors) >= 2  # The solver reports extra conjugate-pair diagnostics here. [Codex GPT-5.4]

print("modes", len(omega))
print("first_freq", omega[0])
print("first_rel_error", rel_errors[0])
PY
    '
